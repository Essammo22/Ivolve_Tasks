
@Library('jenkins-shared-library') _

pipeline {
    agent {
        label 'linux-agent'
    }
    stage('Check Java Environment') {
     steps {
        sh '''
            echo "JAVA_HOME=$JAVA_HOME"
            which java
            which javac
            which mvn
            java -version
            javac -version
            mvn -version
        '''
     }
    }

    stages {

        stage('Build Application') {
            steps {
                dir('jenkins_labs/lab22/DemoApp') {
                    BuildApp()
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('jenkins_labs/lab22/DemoApp') {
                    BuildImage('essammo22/demoapp')
                }
            }
        }

        stage('Deploy Application') {
            steps {
                DeployOnK8s("essammo22/demoapp:${env.BUILD_NUMBER}")
            }
        }
    }
}

