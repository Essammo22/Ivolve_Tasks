
pipeline {
    agent {
        label 'linux-agent'
    }

    stages {
        stage('Check Workspace') {
            steps {
                sh '''
                    echo "=== HOSTNAME ==="
                    hostname

                    echo "=== WORKSPACE ==="
                    pwd

                    echo "=== ROOT FILES ==="
                    ls -la

                    echo "=== DEMOAPP FILES ==="
                    ls -la DemoApp || true

                    echo "=== FIND POM ==="
                    find . -name pom.xml
                '''
            }
        }
    }
}

